# ==========================================
# Backend Database Config (PostgreSQL)
# ==========================================
DB_HOST=postgres          # Database host (service name in Docker network, or 'localhost' for local run)
DB_PORT=5433              # Port for connecting to PostgreSQL
DB_NAME=arcabank_db       # Name of the main project database
DB_USER=postgres          # Database administrator username
DB_PASSWORD=postgres      # Database administrator password (CHANGE IN PRODUCTION)

# ==========================================
# pgAdmin Config (Database Management GUI)
# ==========================================
PGADMIN_DEFAULT_EMAIL=acorn@arcabank.com          # Email for logging into the pgAdmin control panel
PGADMIN_DEFAULT_PASSWORD=acorn_secret_password    # Password for logging into pgAdmin
PGADMIN_PORT=5050                                 # Port where the pgAdmin web interface will be available

# ==========================================
# Security / JWT (Token Configuration)
# ==========================================
JWT_SECRET_KEY=super_secret_jwt_acorn_key_for_arcabank_project # Secret key used to sign JWT tokens (must be secure/complex)
JWT_EXPIRATION_TIME=86400000                                   # Authorization token lifespan in milliseconds (86400000 = 24 hours)

# ==========================================
# Frontend Config (Client to Backend Connection)
# ==========================================
ANGULAR_APP_API_BASE_URL=http://localhost:8088/api/v1          # Base API URL where the Angular application sends its requests

# ==========================================
# Config encrypt (Encryption Setup)
# ==========================================
CONFIG_ENCRYPT_KEY=great-acorns-team-key-2026                  # Master key for symmetric encryption of sensitive configuration data
